{
  "name": "g2-brief",
  "private": true,
  "version": "0.1.0",
  "description": "Brief — glanceable Telegram briefing and one-tap AI replies for Even G2 glasses.",
  "workspaces": [
    "packages/shared",
    "services/api",
    "apps/glass",
    "tools/demo-frames"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @brief/api",
    "dev:glass": "npm run dev -w @brief/glass",
    "demo:frames": "npm run generate -w @brief/demo-frames"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
