# Brief API
BRIEF_PORT=8787
BRIEF_HOST=127.0.0.1
BRIEF_PUBLIC_URL=http://127.0.0.1:8787

# Optional: live Telegram Bot API (leave unset to use the demo inbox)
# TELEGRAM_BOT_TOKEN=

# Optional: OpenAI-compatible draft endpoint (leave unset to use the built-in draft engine)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: Whisper-compatible STT (leave unset to use keyword / command parsing only)
# WHISPER_URL=
# WHISPER_API_KEY=

# Glass app (apps/glass/.env.local or root Vite env)
# VITE_BRIEF_API=http://127.0.0.1:8787
